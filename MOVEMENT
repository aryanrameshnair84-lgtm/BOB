#include <BleGamepad.h>

// Initialize the BLE Gamepad name
BleGamepad bleGamepad("Bob_Robot_Controller", "Exhibition", 100);

// --- Motor Pin Definitions for 4WD ---
#define LEFT_MOTOR_IN1  12
#define LEFT_MOTOR_IN2  13
#define RIGHT_MOTOR_IN1 26
#define RIGHT_MOTOR_IN2 27

// --- Microphone Sensor Pin ---
#define MIC_PIN         34

bool isWalking = false;

void setup() {
  Serial.begin(115200);

  // Initialize Motor Pins
  pinMode(LEFT_MOTOR_IN1, OUTPUT);
  pinMode(LEFT_MOTOR_IN2, OUTPUT);
  pinMode(RIGHT_MOTOR_IN1, OUTPUT);
  pinMode(RIGHT_MOTOR_IN2, OUTPUT);

  // Initialize Microphone Pin
  pinMode(MIC_PIN, INPUT);

  // Start the BLE Gamepad service
  bleGamepad.begin();

  Serial.println("--- Bob's 4WD, WASD, Mic & Bluetooth Controller Ready ---");
  Serial.println("Waiting for Bluetooth Controller connection...");
}

void loop() {
  // 1. Check for manual WASD commands typed in the Serial Monitor
  if (Serial.available() > 0) {
    char command = Serial.read();
    if (command != '\n' && command != '\r') {
      executeCommand(command);
    }
  }

  // 2. Check microphone input (clap or loud sound toggle)
  int micValue = analogRead(MIC_PIN);
  if (micValue > 2000) { 
    isWalking = !isWalking;
    if (isWalking) {
      Serial.println("-> [Mic] Bob starts walking forward!");
      moveForward();
    } else {
      Serial.println("-> [Mic] Bob stops.");
      stopRobot();
    }
    delay(1000); // Debounce delay
  }

  // 3. Check if a Bluetooth device is connected
  if (bleGamepad.isConnected()) {
    // When acting as a BLE gamepad server, the ESP32 receives data packets 
    // via automated report callbacks. For simple custom wireless remote driving, 
    // it's much more reliable to control Bob via Serial/Bluetooth Terminal apps 
    // (like an Android Bluetooth terminal app sending W, A, S, D chars) 
    // or keep using the WASD keys while connected.
  }
}

// --- Command Parser for Serial/WASD/Remote ---
void executeCommand(char cmd) {
  cmd = tolower(cmd);
  switch (cmd) {
    case 'w': moveForward(); Serial.println("-> [Control] Forward"); break;
    case 's': moveBackward(); Serial.println("-> [Control] Backward"); break;
    case 'a': turnLeft(); Serial.println("-> [Control] Left"); break;
    case 'd': turnRight(); Serial.println("-> [Control] Right"); break;
    case 'x': stopRobot(); Serial.println("-> [Control] Stop"); break;
    default: Serial.println("Unknown command."); break;
  }
}

// --- 4WD Movement Functions ---
void moveForward() {
  digitalWrite(LEFT_MOTOR_IN1, HIGH);  digitalWrite(LEFT_MOTOR_IN2, LOW);
  digitalWrite(RIGHT_MOTOR_IN1, HIGH); digitalWrite(RIGHT_MOTOR_IN2, LOW);
}

void moveBackward() {
  digitalWrite(LEFT_MOTOR_IN1, LOW);  digitalWrite(LEFT_MOTOR_IN2, HIGH);
  digitalWrite(RIGHT_MOTOR_IN1, LOW); digitalWrite(RIGHT_MOTOR_IN2, HIGH);
}

void turnRight() {
  digitalWrite(LEFT_MOTOR_IN1, HIGH);  digitalWrite(LEFT_MOTOR_IN2, LOW);
  digitalWrite(RIGHT_MOTOR_IN1, LOW); digitalWrite(RIGHT_MOTOR_IN2, HIGH);
}

void turnLeft() {
  digitalWrite(LEFT_MOTOR_IN1, LOW);  digitalWrite(LEFT_MOTOR_IN2, HIGH);
  digitalWrite(RIGHT_MOTOR_IN1, HIGH); digitalWrite(RIGHT_MOTOR_IN2, LOW);
}

void stopRobot() {
  digitalWrite(LEFT_MOTOR_IN1, LOW);  digitalWrite(LEFT_MOTOR_IN2, LOW);
  digitalWrite(RIGHT_MOTOR_IN1, LOW); digitalWrite(RIGHT_MOTOR_IN2, LOW);
}
